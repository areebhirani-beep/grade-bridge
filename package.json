{
  "name": "grade-bridge",
  "version": "0.1.0",
  "description": "Turn a color grade from any app into a standard 3D LUT (.cube) that DaVinci Resolve, Premiere, Final Cut, CapCut, OBS and Photoshop can load.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "grade-bridge": "dist-node/cli.js"
  },
  "files": [
    "dist-node",
    "presets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "node scripts/verify-ffmpeg.ts",
    "chart": "node scripts/make-chart.ts",
    "cli": "node src/cli.ts"
  },
  "keywords": [
    "lut",
    "cube",
    "color-grading",
    "davinci-resolve",
    "premiere",
    "final-cut",
    "webgl2"
  ],
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@types/node": "^26.6.5"
  }
}
